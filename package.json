{
  "name": "hdp-portal",
  "version": "2.0.0",
  "private": true,
  "description": "Hundred Days Programme (HDP) — Kerala CMO Portal Rebuild",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest __tests__/unit",
    "test:components": "jest __tests__/components",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:perf": "node scripts/lighthouse-test.js",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "zip:prod": "powershell -ExecutionPolicy Bypass -File scripts/create-prod-zip.ps1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
