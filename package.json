    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "swr": "^2.4.2",
