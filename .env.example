# --- Database ---
DATABASE_URL=postgres://hdp_app_user:CHANGE_ME@localhost:5432/hdp?options=-c%20search_path%3Dhdp,public

# --- NextAuth.js v5 ---
AUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Session ---
SESSION_TTL_HOURS=8
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=30

# --- Password Reset (SMS) ---
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# --- App ---
NEXT_PUBLIC_APP_NAME=HDP Kerala
# NEXT_PUBLIC_PHASE_START=2026-07-15
NEXT_PUBLIC_PHASE_START=2026-06-25
NEXT_PUBLIC_PHASE_END=2026-10-22
